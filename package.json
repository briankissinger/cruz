{
  "name": "cruz",
  "version": "1.0.0",
  "description": "Enterprise-grade multi-tenant payment gateway",
  "main": "dist/server.js",
  "scripts": {
    "dev:start": "cross-env NODE_ENV=development node --watch --env-file=.env.development --import=tsx src/server.ts",
    "build": "tsc",
    "dev:qa": "cross-env NODE_ENV=qa node --env-file=.env.qa dist/server.js",
    "staging": "cross-env NODE_ENV=staging node --env-file=.env.staging dist/server.js",
    "start": "cross-env NODE_ENV=production node --env-file=.env.production dist/server.js",
    "dev:db:generate": "node --env-file=.env.development && drizzle-kit generate",
    "prod:db:generate": "node --env-file=.env.production && drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.1.3",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "@inversifyjs/http-core": "^5.4.5",
    "@inversifyjs/http-express": "^5.4.5",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "bullmq": "^5.79.2",
    "drizzle-orm": "1.0.0-rc.4",
    "express": "^5.2.1",
    "inversify": "^8.1.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-loki": "^3.0.0",
    "pino-roll": "^4.0.0",
    "prom-client": "^15.1.3",
    "redis": "^6.1.0",
    "reflect-metadata": "^0.2.2",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuidv7": "^1.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.20.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}