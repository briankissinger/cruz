# Application
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cruz?schema=public
DATABASE_POOL_SIZE=10
DATABASE_SSL=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# JWT (RS256 keys - generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem)
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQD...\n-----END PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...\n-----END PUBLIC KEY-----
JWT_ISSUER=cruz
JWT_AUDIENCE=cruz-api

# Tenant Webhook Configuration
TENANT_WEBHOOK_TIMEOUT_MS=10000
TENANT_WEBHOOK_MAX_RETRIES=3

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

# Logging (Pino + Loki)
PINO_LOG_LEVEL=info
PINO_LOG_FILE=./logs/cruz.log
PINO_LOKI_HOST=localhost
PINO_LOKI_PORT=3100
PINO_LOKI_USERNAME=
PINO_LOKI_PASSWORD=

# OpenTelemetry
OTEL_SERVICE_NAME=cruz
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_HEADERS=

# Prometheus
PROMETHEUS_PORT=9090
PROMETHEUS_PATH=/metrics

# Docker
DOCKER_CONTAINER=false